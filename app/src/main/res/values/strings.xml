    <!-- Sync guide -->
    <string name="sync_title">Sync with Syncthing</string>
    <string name="sync_steps">1. Install Syncthing on each device (Syncthing-Fork on Android).\n\n2. In OmniNote, choose a notes folder, for example Documents/OmniNote.\n\n3. In Syncthing, share that same folder with your other devices.\n\n4. OmniNote refreshes by itself when Syncthing brings changes. If a note changed on two devices, it appears under the Conflicts filter.</string>
    <string name="sync_internal_warning">Your notes are stored inside OmniNote right now, where Syncthing cannot reach them. Choose a notes folder first.</string>
